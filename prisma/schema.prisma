generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantEstado {
  activo
  pausado
}

enum PausaMotivo {
  manual
  impago
  onboarding
  baja
}

enum VerificacionWhatsapp {
  pendiente
  en_revision
  verificado
  rechazado
}

enum TicketTipo {
  ia_personalizada
  arrepentimiento
}

enum CanalTipo {
  whatsapp
  instagram
  telegram
  tiktok
}

enum MedioPago {
  mercadopago
}

enum EstadoPago {
  al_dia
  pendiente
  impago
}

enum TicketEstado {
  nuevo
  en_gestion
  cotizado
  contratado
  descartado
}

enum TurnoEstado {
  reservado
  confirmado
  cancelado
}

enum ComisionEstado {
  pendiente
  pagada
  anulada
}

model Plan {
  id                  String   @id
  nombre              String
  precioTransferencia Int
  precioMercadoPago   Int
  precioMensajeExtra  Int      @default(45)
  topeDia             Int
  topeSemana          Int
  topeMes             Int
  modulos             String[]
  maxCanales          Int
  modeloCapaz         Boolean  @default(false)
  tenants             Tenant[]
  tenantsPendientes   Tenant[] @relation("PlanPendiente")
}

model Tenant {
  id                  String        @id
  nombre              String
  estado              TenantEstado  @default(activo)
  pausaMotivo         PausaMotivo?
  planId              String
  plan                Plan          @relation(fields: [planId], references: [id])
  planElegido         Boolean       @default(true)
  planPendienteId     String?
  planPendiente       Plan?         @relation("PlanPendiente", fields: [planPendienteId], references: [id])
  timezone            String        @default("America/Argentina/Buenos_Aires")
  rubro               String?
  perfil              Json?
  onboardingPaso      Int           @default(0)
  onboardingCompletado DateTime?
  modelo              String        @default("barato")
  prompt              String        @default("")
  mensajes            Json
  modulos             String[]
  topeDia             Int
  topeSemana          Int
  topeMes             Int
  precioPersonalizado Int?
  emailContacto       String?
  publicToken         String        @unique
  webActiva           Boolean       @default(false)
  webClave            String?       @unique
  webOrigenes         String[]      @default([])
  webBienvenida       String?
  webColor            String?
  demo                Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  canales             Channel[]
  subscription        Subscription?
  payments            Payment[]
  usage               Usage[]
  conversations       Conversation[]
  turnos              Turno[]
  ticket              Ticket?
  usuario             ClientUser?
  demoFuentes         DemoFuente[]
  referido            Referral?
  comision            Commission?
  correos             CorreoEnviado[]
  calendario          Calendario?
  cargos              CargoExtra[]
}

model DemoFuente {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo      String
  nombre    String
  contenido String
  filas     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ClientUser {
  id             String            @id @default(cuid())
  tenantId       String            @unique
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String            @unique
  nombre         String
  passwordHash   String
  resetTokenHash String?           @unique
  resetExpira       DateTime?
  ultimoLogin       DateTime?
  avisosComerciales Boolean         @default(true)
  createdAt         DateTime        @default(now())
  aceptaciones      LegalAcceptance[]
  afiliado          Affiliate?
}

model CorreoEnviado {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  tipo      String
  clave     String
  createdAt DateTime @default(now())

  @@unique([email, tipo, clave])
  @@index([tenantId, tipo])
}

model LegalAcceptance {
  id        String     @id @default(cuid())
  userId    String
  user      ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  documento String
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId, documento])
}

model Channel {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo       CanalTipo
  endpointId String    @unique
  etiqueta              String
  tokenEnc              String?
  wabaId                String?
  verificacion          VerificacionWhatsapp?
  verificacionDetalle   String?
  displayPhone          String?
  /// Host de Graph cuando el token no es el de Instagram Login (por ejemplo, el de una página de Facebook).
  apiBase               String?
}

model Usage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo  String
  count    Int    @default(0)

  @@unique([tenantId, periodo])
}

model Conversation {
  id           String   @id @default(cuid())
  /// Identificador público. El enlace de la charla y el reporte de un fallo usan este UUID.
  codigo       String   @unique @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriberId String
  canal        CanalTipo?
  endpointId   String?
  destino      String?
  nombre             String?
  handoffHasta       DateTime?
  ultimoClienteAt    DateTime?
  ventanaDesde       DateTime?
  respuestasVentana  Int       @default(0)
  historial          Json
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, subscriberId])
}

model Subscription {
  tenantId        String     @id
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medio           MedioPago
  estadoPago      EstadoPago @default(pendiente)
  diaAbono        Int
  vencimiento     DateTime
  mpPreapprovalId String?    @unique
  mpInitPoint     String?
  mpEstado        String?
  canceladaEn     DateTime?
  updatedAt       DateTime   @updatedAt
}

model Payment {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medio       MedioPago
  importe     Int
  periodo     String
  externalId  String?   @unique
  acreditaEn  DateTime?
  createdAt   DateTime  @default(now())
  comision    Commission?
}

model Affiliate {
  id             String       @id @default(cuid())
  email          String       @unique
  nombre         String
  passwordHash   String
  codigo         String       @unique
  datosCobro     String?
  resetTokenHash String?      @unique
  resetExpira    DateTime?
  aceptaTerminos DateTime
  clientUserId   String?      @unique
  clientUser     ClientUser?  @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  referidos      Referral[]
  comisiones     Commission[]
}

model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

model Commission {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tenantId    String         @unique
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId   String         @unique
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  importe     Int
  estado      ComisionEstado @default(pendiente)
  pagableDesde DateTime
  pagarAntes  DateTime
  pagadaEn    DateTime?
  createdAt   DateTime       @default(now())

  @@index([affiliateId, estado])
}

model Calendario {
  tenantId   String   @id
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshEnc String
  email      String?
  createdAt  DateTime @default(now())
}

model CargoExtra {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo        String
  cantidad       Int         @default(0)
  precioUnitario Int
  importeCobrado Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pagos          PagoExtra[]

  @@unique([tenantId, periodo])
}

model PagoExtra {
  id         String     @id @default(cuid())
  cargoId    String
  cargo      CargoExtra @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  importe    Int
  externalId String     @unique
  createdAt  DateTime   @default(now())
}

model Ticket {
  id             String       @id @default(cuid())
  tipo           TicketTipo   @default(ia_personalizada)
  privacidadVersion String?
  ip             String?
  nombre         String
  email          String
  telefono       String?
  empresa        String
  rubro          String
  necesidad      String
  estado         TicketEstado @default(nuevo)
  importeMensual Int?
  notas          String?
  tenantId       String?      @unique
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Turno {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriberId        String
  nombre              String
  fecha               DateTime
  estado              TurnoEstado @default(reservado)
  recordatorioEnviado Boolean     @default(false)
  eventoExternoId     String?
  createdAt           DateTime    @default(now())

  @@index([tenantId, fecha])
}
